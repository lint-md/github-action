{
  "name": "@lint-md/github-action",
  "version": "0.3.0",
  "description": "github action for lint-md",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest --no-cache",
    "lint": "eslint --max-warnings 0 ./src",
    "build": "node esbuild.config.mjs",
    "build:dev": "node esbuild.config.mjs --dev",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuzhanglong/hello-world-javascript-action.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yuzhanglong/hello-world-javascript-action/issues"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@actions/core$": "<rootDir>/__mocks__/@actions/core.js"
    },
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!**/node_modules/**",
      "!**/vendor/**"
    ]
  },
  "homepage": "https://github.com/yuzhanglong/hello-world-javascript-action#readme",
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@lint-md/core": "^2.3.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.15.0",
    "glob": "^13.0.6",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "type": "commonjs",
  "files": [
    "dist",
    "src"
  ]
}
